# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to GitHub.

# --- LLM provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# --- Optional tuning ---
# LLM_MAX_OUTPUT_TOKENS=16384   # raise if summaries sometimes come back cut off
# GEMINI_THINKING_LEVEL=low     # optional: less internal thinking = faster, fewer cut-off replies (untested on every model)
# HF_HUB_OFFLINE=1             # after the first model download: no network check at start

# --- Translation (optional) ---
TRANSLATION_BATCH_SIZE=12

# --- Embeddings / retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# --- Uploads ---
MAX_UPLOAD_MB=25
UPLOAD_DIR=data/uploads
INDEX_DIR=data/indexes

# --- Server ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
